# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# MATLAB
*.asv
*.mex*
slprj/
*.autosave
octave-workspace

# Outputs / figures generated by examples
outputs/
*.png
*.pdf
!docs/**/*.png
# Generated calc notes (regenerated per run, often from local params)
laskumuistio_*.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local state (keep CLAUDE.md, ignore local settings)
.claude/settings.local.json

# Per-machine auto-push opt-in marker (each user enables locally)
.claude/autopush.enabled
# Per-machine capture opt-out marker (disables capture AND push; docs/09)
.claude/capture.disabled
# Local hook error log (capture/push failures; docs/09)
.claude/hooks/hook_errors.log

# Third-party agent skills installed locally (install per docs/08, don't vendor)
.agents/
# Ignore runtime skill symlinks, but keep skills authored in this repo
.claude/skills/*
!.claude/skills/robot-structural/
!.claude/skills/eurocode-fi/

# Filled NA parameter files hold the user's licensed values — keep only templates
params/*.yaml
!params/*.example.yaml

# Third-party Robot MCP server, cloned by setup.ps1 (docs/14)
tools/
